# ─── TACMUX Configuration ────────────────────────────────────────────────────
# Copy to ~/.config/tacmux/tacmux.conf and customize.
# All values shown are defaults — uncomment and change as needed.

# Base workspace directory (Exegol: /workspace, Kali/generic: ~/workspace)
#TACMUX_WORKSPACE="$HOME/workspace"

# Archive directory for completed engagements
#TACMUX_ARCHIVE_DIR="$HOME/archives"

# Fallback log directory for non-op sessions
#TACMUX_LOG_DIR="$HOME/logs"

# Auto-start logging on new panes/windows (true/false)
#TACMUX_AUTOLOG="true"

# Target subdirectories (space-separated)
#TACMUX_TARGET_DIRS="recon exploitation loot screenshots reports logs"

# Auto-configure NOCAP_WORKSPACE when cap is detected (true/false)
#TACMUX_NOCAP_INTEGRATION="true"

# Colored output (true/false)
#TACMUX_COLOR="true"
