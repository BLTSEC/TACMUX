# TACMUX v3 keeps engagement state in each workspace's SITREP.md.

[paths]
workspace = "~/workspace"
# Optional: keep each canonical SITREP under this notes directory.
# sitrep_root = "~/notes/engagements"   # tm notes changes this line

[behavior]
auto_log = true
session_prefix = "tacmux-"
# Write readable .txt copies of the pane logs (and copy shell logs) when
# `tm stop` / `tm close` stop a session.
snapshot_on_stop = true

[integrations]
# Shell-handler session logs copied into captures/<target>/shells/ by
# `tm access`, `tm proof`, `tm snap`, `tm stop`, `tm close`, `tm evidence` (penelope names: host~IP-OS…). [] = off.
shell_log_dirs = ["~/.penelope/sessions"]
