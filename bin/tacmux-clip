#!/usr/bin/env bash
# Explicit clipboard bridge for trusted TACMUX copy operations.

set -euo pipefail

if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
    exec tmux load-buffer -w -
fi

if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
fi

if [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null 2>&1; then
    exec xclip -in -selection clipboard
fi

if [[ -n "${DISPLAY:-}" ]] && command -v xsel >/dev/null 2>&1; then
    exec xsel --clipboard --input
fi

if command -v pbcopy >/dev/null 2>&1; then
    exec pbcopy
fi

if [[ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" && -w /dev/tty ]]; then
    printf '\033]52;c;' > /dev/tty
    base64 | tr -d '\n' > /dev/tty
    printf '\a' > /dev/tty
    exit 0
fi

echo "tacmux clip: no supported clipboard transport" >&2
exit 1
