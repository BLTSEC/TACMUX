/* TACMUX uses one semantic visual system across every complete dark palette. */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
}

Footer {
    background: $surface;
    color: $text-muted;
}

FooterKey {
    color: $footer-key-foreground;
    text-style: bold;
}

ContentTabs {
    background: $surface;
    color: $text-muted;
}

Tab {
    padding: 0 1;
    color: $text-muted;
}

Tab:hover {
    color: $foreground;
    background: $primary 8%;
}

Tab.-active {
    color: $primary;
    background: $primary 16%;
    text-style: bold;
}

TabPane {
    padding: 1;
    background: $background;
}

Input,
SelectCurrent,
SelectOverlay,
TextArea,
SelectionList,
OptionList {
    background: $surface;
    border: tall $border-blurred;
}

Input:focus,
Select:focus > SelectCurrent,
TextArea:focus,
SelectionList:focus,
OptionList:focus {
    border: tall $border;
    background-tint: $primary 5%;
}

Button {
    min-width: 14;
    color: $foreground;
    background: $panel;
    border: tall $border-blurred;
    text-style: bold;
}

Button:hover,
Button:focus {
    border: tall $border;
    background: $primary 16%;
}

Button.-primary {
    color: $button-color-foreground;
    background: $primary;
    border: tall $primary;
}

Button.-error {
    color: $button-color-foreground;
    background: $error;
    border: tall $error;
}

DataTable {
    background: $surface;
    border: tall $border-blurred;
}

DataTable:focus {
    border: tall $secondary 65%;
    background-tint: $primary 4%;
}

DataTable > .datatable--header {
    color: $primary;
    background: $panel;
    text-style: bold;
}

DataTable:focus > .datatable--cursor {
    color: $block-cursor-foreground;
    background: $block-cursor-background;
    text-style: bold;
}

#picker-body {
    margin: 1 2;
    padding: 1 2;
    background: $surface;
    border: round $border-blurred;
}

#picker-title {
    height: 2;
    color: $primary;
    text-style: bold;
}

#picker-copy {
    height: 2;
    color: $text-muted;
}

#picker-hint {
    height: 2;
    padding-top: 1;
    color: $text-muted;
}

#engagement-filter,
#target-filter {
    display: none;
    margin: 0 2;
}

#engagement-banner {
    width: 100%;
    height: 3;
    padding: 0 2;
    background: $panel;
    border-bottom: solid $border-blurred;
    content-align: left middle;
    text-overflow: ellipsis;
}

#workspace-tabs {
    height: 1fr;
}

#target-layout,
#documents-layout {
    height: 1fr;
}

#target-table {
    width: 62%;
    height: 1fr;
}

#target-detail {
    width: 38%;
    padding: 1 2;
    margin-left: 1;
    background: $surface;
    border: tall $border-blurred;
    overflow-y: auto;
}

ScopeDiscoveryPane {
    height: 1fr;
}

#scope-table {
    height: 43%;
}

#jobs-table {
    height: 35%;
}

#records-table {
    height: 1fr;
}

.section-title {
    height: 2;
    padding: 0 1;
    color: $primary;
    background: $surface;
    text-style: bold;
    content-align: left middle;
}

#situation-view {
    height: 1fr;
    padding: 1 2;
    background: $surface;
    border: tall $border-blurred;
    overflow-y: auto;
}

#documents-table {
    width: 38%;
    height: 1fr;
}

#document-preview {
    width: 62%;
    padding: 1 2;
    margin-left: 1;
    background: $surface;
    border: tall $border-blurred;
    overflow-y: auto;
}

BaseModal {
    align: center middle;
    background: $background 82%;
}

BaseModal > Vertical,
BaseModal > VerticalScroll {
    background: $surface;
    border: round $border;
}

BaseModal .title,
.modal-title {
    color: $primary;
    text-style: bold;
}

BaseModal .field-label {
    color: $text-muted;
    text-style: bold;
}

BaseModal .buttons,
.modal-buttons {
    height: auto;
    margin-top: 0;
    align-horizontal: right;
}

.modal-buttons Button {
    margin-left: 1;
}

.modal-copy {
    height: 2;
    color: $text-muted;
}

MainScreen.narrow TabPane {
    padding: 0;
}

MainScreen.narrow #target-layout,
MainScreen.narrow #documents-layout {
    layout: vertical;
}

MainScreen.narrow #target-table,
MainScreen.narrow #documents-table {
    width: 1fr;
    height: 55%;
}

MainScreen.narrow #target-detail,
MainScreen.narrow #document-preview {
    width: 1fr;
    height: 45%;
    margin-left: 0;
    margin-top: 1;
}
